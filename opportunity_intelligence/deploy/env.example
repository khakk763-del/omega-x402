# Placeholders only. Fill these in the hosting provider's secure environment UI.
# Never commit real secrets and never paste them in chat.

# Public receive address on the network the user confirms for production.
OMEGA_PAY_TO=
# Production network, for example eip155:8453 for Base mainnet.
OMEGA_X402_NETWORK=eip155:8453
# USDC asset on Base mainnet (verify before production).
OMEGA_X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Facilitator choice: payai or cdp. Credentials, if any, belong to the user.
OMEGA_X402_FACILITATOR=payai
# CDP only: set in the provider's secure environment, not in this file.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Service port for local smoke tests.
PORT=8765
